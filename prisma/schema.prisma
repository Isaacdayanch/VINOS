// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum CategoriaPrecio {
  LISTA
  DESCUENTO_CHICO
  DESCUENTO_GRANDE
}

enum Moneda {
  MXN
  USD
}

enum Cuenta {
  EFECTIVO
  CUENTA // banco / tarjeta / digital
}

enum OrigenPago {
  INYECCION_CAPITAL // dinero nuevo que pone un socio de su bolsillo
  REINVERSION // dinero que ya estaba guardado en Caja/Cuenta, de ventas pasadas
}

model Producto {
  id                    String   @id @default(cuid())
  nombre                String
  sku                   String   @unique
  piezasPorCaja         Int
  anio                  Int?
  proveedor             String?
  categoria             String?
  activo                Boolean  @default(true)
  fotoUrl               String?
  stockMinimo           Int?
  precioLista           Float?
  precioDescuentoChico  Float?
  precioDescuentoGrande Float?
  createdAt             DateTime @default(now())

  entradas       EntradaLinea[]
  salidas        Salida[]
  ordenLineas    OrdenLinea[]
  preciosCliente PrecioClienteProducto[]
}

model Cliente {
  id              String          @id @default(cuid())
  nombre          String
  telefono        String?
  email           String?
  categoriaPrecio CategoriaPrecio @default(LISTA)
  notas           String?
  createdAt       DateTime        @default(now())

  ordenes         Orden[]
  preciosProducto PrecioClienteProducto[]
}

model PrecioClienteProducto {
  id         String   @id @default(cuid())
  clienteId  String
  productoId String
  precio     Float
  updatedAt  DateTime @updatedAt

  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([clienteId, productoId])
}

model Socio {
  id     String @id @default(cuid())
  nombre String

  pagos   Pago[]
  salidas Salida[]
}

model Pedido {
  id           String   @id @default(cuid())
  folio        String   @unique
  fecha        DateTime
  proveedor    String?
  tipoCambio   Float? // pesos por dólar, para convertir costos en USD de este pedido
  logisticaUSD Float? // flete + seguro (dólares)
  logisticaMXN Float? // aduana + maniobras + otros gastos (pesos)
  notas        String?
  createdAt    DateTime @default(now())

  entradas EntradaLinea[]
  pagos    Pago[]
}

model EntradaLinea {
  id             String   @id @default(cuid())
  pedidoId       String
  productoId     String
  fecha          DateTime
  cajasRecibidas Float
  piezasPorCaja  Int
  costoPorCaja   Float // dólares
  recibida       Boolean  @default(false) // false = apartado con el proveedor, aún no llega físicamente
  createdAt      DateTime @default(now())

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])
}

model Orden {
  id        String   @id @default(cuid())
  folio     String   @unique
  fecha     DateTime
  clienteId String
  estatus   String   @default("Cotización")
  createdAt DateTime @default(now())

  cliente Cliente      @relation(fields: [clienteId], references: [id])
  lineas  OrdenLinea[]
  cobros  Cobro[]
}

model OrdenLinea {
  id               String @id @default(cuid())
  ordenId          String
  productoId       String
  cantidadBotellas Int
  precioUnitario   Float
  costoUnitario    Float // costo por botella al momento de vender (para calcular margen)

  orden    Orden    @relation(fields: [ordenId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])
}

model Salida {
  id            String   @id @default(cuid())
  fecha         DateTime
  productoId    String
  botellas      Int
  motivo        String // "Venta", "Muestra/Degustación", "Consumo personal", "Merma/Otro"
  costoUnitario Float? // costo por botella al momento de salir (para "Consumo personal")
  socioId       String? // quién se la llevó, si motivo = "Consumo personal" y no fue compartida
  dividido      Boolean  @default(false) // true = Isaac y Beto se la repartieron, no genera deuda
  ordenId       String?
  notas         String?
  createdAt     DateTime @default(now())

  producto Producto @relation(fields: [productoId], references: [id])
  socio    Socio?   @relation(fields: [socioId], references: [id])
}

model Cobro {
  id          String   @id @default(cuid())
  ordenId     String
  fecha       DateTime
  monto       Float
  cuenta      Cuenta   @default(EFECTIVO)
  comisionPct Float    @default(0) // % que se descuenta si cuenta = CUENTA (ej. comisión de tarjeta)
  metodoPago  String?
  notas       String?

  orden Orden @relation(fields: [ordenId], references: [id])
}

model Pago {
  id         String     @id @default(cuid())
  fecha      DateTime
  pedidoId   String? // null = gasto interno, no ligado a un pedido
  concepto   String
  moneda     Moneda
  monto      Float
  tipoCambio Float? // solo si moneda = USD, para saber a cuántos pesos equivale
  cuenta     Cuenta     @default(EFECTIVO) // de dónde salió el dinero
  origen     OrigenPago @default(REINVERSION)
  esMaaser   Boolean    @default(false) // diezmo (10% de la ganancia), no cuenta como inversión del negocio
  metodoPago String?
  socioId    String? // null = dividido entre socios (o no aplica, si origen = REINVERSION)
  dividido   Boolean    @default(false)
  notas      String?
  createdAt  DateTime   @default(now())

  pedido Pedido? @relation(fields: [pedidoId], references: [id])
  socio  Socio?  @relation(fields: [socioId], references: [id])
}
